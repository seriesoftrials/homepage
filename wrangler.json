{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "serial-homepage",
  "account_id": "8406a5140c860dd8913de7a07d7624ba",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "preview_urls": false,
