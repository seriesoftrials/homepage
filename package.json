{
  "name": "homepage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run build:grainy",
    "dev": "next dev",
    "build:grainy": "node scripts/build-grainy.mjs",
    "prebuild": "npm run build:grainy",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run build && npm test && npm run deploy:check",
    "deploy:check": "npm run build:grainy && wrangler deploy --dry-run --outdir .deploy-local/check",
    "predeploy": "npm run build:grainy",
    "deploy": "node scripts/deploy.mjs",
    "deploy:verify": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.149.0"
  }
}
